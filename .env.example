# BCC007Portal environment variables
# Copy this file to `.env` and fill in real values. Required vars are listed
# first; optional ones follow. Never commit the real `.env`.

NODE_ENV=development

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=info@bcc007-group.org
EMAIL_PASSWORD=your-password

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=mongodb://localhost:27017/bcc007portal
DATABASE_NAME=bcc007portal

# Client
CLIENT_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_SECRET_KEY=your-secret
CLOUDINARY_UPLOAD_PRESET=your-preset

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# QStash
QSTASH_TOKEN=your-token
QSTASH_URL=https://qstash.upstash.io

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-key

# AI (OpenCode Zen / OpenAI-compatible gateway)
OPENCODE_ZEN_API_KEY=your-key

# Upstash Vector (semantic guide search, chatbot RAG)
# UPSTASH_VECTOR_REST_URL=https://xxx-xxx.vector.upstash.io
# UPSTASH_VECTOR_REST_TOKEN=xxx

# --- Optional ---
# BREVO_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_KEY=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
